{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenêtre principale : commandes NOVA et sélecteurs de fichiers.",
  "windows": [
    "main",
    "quick",
    "island-*",
    "cursor-*",
    "control-ask",
    "control-notch",
    "remote-notch"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "updater:default",
    "process:allow-restart"
  ]
}